diff --git a/dm/gfx/tests/t_res_trace.m b/dm/gfx/tests/t_res_trace.m
new file mode 100644
index 0000000..6915760
--- /dev/null
+++ b/dm/gfx/tests/t_res_trace.m
@@ -0,0 +1,97 @@
+// A gated residency commit proves that its begin checkpoint is already readable
+// while the driver has not returned, and that tracing does not change its waits.
+#import "../nvn/nvn_mtl.m"
+
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+
+@interface GatedResidency : NSObject
+
+@property (strong) id<MTLResidencySet> delegate;
+@property (strong) dispatch_semaphore_t entered;
+@property (strong) dispatch_semaphore_t releaseCommit;
+- (void)addAllocation:(id<MTLAllocation>)allocation;
+- (void)removeAllocation:(id<MTLAllocation>)allocation;
+- (void)commit;
+
+@end
+
+@implementation GatedResidency
+
+- (void)addAllocation:(id<MTLAllocation>)allocation {
+    [self.delegate addAllocation:allocation];
+}
+
+- (void)removeAllocation:(id<MTLAllocation>)allocation {
+    [self.delegate removeAllocation:allocation];
+}
+
+- (void)commit {
+    dispatch_semaphore_signal(self.entered);
+    dispatch_semaphore_wait(self.releaseCommit, DISPATCH_TIME_FOREVER);
+    [self.delegate commit];
+}
+
+@end
+
+static int checks, failed;
+#define CHECK(label, c) do { checks++; if (!(c)) { failed++; printf("FAIL: %s\n", label); } } while (0)
+
+static int log_has(FILE *log, const char *text) {
+    fflush(stderr);
+    char bytes[32768];
+    ssize_t n = pread(fileno(log), bytes, sizeof(bytes) - 1, 0);
+    if (n < 0) return 0;
+    bytes[n] = 0;
+    return strstr(bytes, text) != NULL;
+}
+
+int main(void) { @autoreleasepool {
+    mtl_init();
+    res_commit();
+    int trace = getenv("DM_RES_TRACE") && atoi(getenv("DM_RES_TRACE")) != 0;
+    FILE *log = tmpfile();
+    if (!log) return 2;
+    fflush(stderr);
+    int saved = dup(STDERR_FILENO);
+    if (saved < 0 || dup2(fileno(log), STDERR_FILENO) < 0) return 2;
+    GatedResidency *gate = [GatedResidency new];
+    gate.delegate = g_res;
+    gate.entered = dispatch_semaphore_create(0);
+    gate.releaseCommit = dispatch_semaphore_create(0);
+    g_res = (id<MTLResidencySet>)gate;
+    id<MTLBuffer> a = [g_dev newBufferWithLength:32u << 20 options:MTLResourceStorageModeShared];
+    res_add(a);
+    dispatch_semaphore_t done = dispatch_semaphore_create(0);
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        res_commit();
+        dispatch_semaphore_signal(done);
+    });
+    int entered = dispatch_semaphore_wait(gate.entered, dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC)) == 0;
+    CHECK("commit reaches the gated driver", entered);
+    if (entered) {
+        CHECK("commit has not returned before the gate opens", dispatch_semaphore_wait(done, DISPATCH_TIME_NOW) != 0);
+        CHECK("begin checkpoint is visible before driver return only when enabled", log_has(log, "begin Metal commit") == trace);
+        char metadata[96];
+        snprintf(metadata, sizeof metadata, "shared buffers %llu", (unsigned long long)a.allocatedSize);
+        CHECK("allocation metadata precedes driver return only when enabled", log_has(log, metadata) == trace);
+        CHECK("no completion checkpoint while driver is blocked", !log_has(log, "Metal commit returned"));
+        // Concurrent changes still queue without waiting for the blocked commit.
+        id<MTLBuffer> b = [g_dev newBufferWithLength:4096 options:MTLResourceStorageModeShared];
+        res_add(b);
+        res_remove(b);
+        CHECK("a blocked commit does not drain later queued changes", res_pending());
+    }
+    dispatch_semaphore_signal(gate.releaseCommit);
+    CHECK("commit completes once driver is released", dispatch_semaphore_wait(done, dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC)) == 0);
+    CHECK("completion checkpoint follows driver return only when enabled", log_has(log, "Metal commit returned") == trace);
+    g_res = gate.delegate;
+    CHECK("tracing preserves actual residency", [g_res containsAllocation:a]);
+    res_remove(a); res_commit();
+    fflush(stderr); dup2(saved, STDERR_FILENO); close(saved); fclose(log);
+    printf("t_res_trace (%s): %d checks, %d failed\n", trace ? "on" : "off", checks, failed);
+    return failed != 0;
+} }
