+static void res_trace_batch(uint64_t seq, const char *caller, res_op *q, size_t n) {
+    uint64_t bytes[2] = {0}, shared = 0;
+    size_t count[2] = {0};
+    id<MTLAllocation> top[8] = {nil};
+    for (size_t i = 0; i < n; i++) {
+        id<MTLAllocation> a = (__bridge id<MTLAllocation>)q[i].o;
+        uint64_t size = a.allocatedSize;
+        int add = q[i].add != 0;
+        bytes[add] += size; count[add]++;
+        if (!add) continue;
+        if ([(id)a conformsToProtocol:@protocol(MTLBuffer)] && ((id<MTLBuffer>)a).storageMode == MTLStorageModeShared) shared += size;
+        for (size_t k = 0; k < 8; k++) if (!top[k] || size > top[k].allocatedSize) {
