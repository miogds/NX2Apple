+        id<MTLBuffer> b = [(id)a conformsToProtocol:@protocol(MTLBuffer)] ? (id<MTLBuffer>)a : nil;
+        MLOG("res trace #%llu largest add %zu: %s object %p bytes %llu storage %ld cpu %p",
+             (unsigned long long)seq, k, b ? "buffer" : [(id)a conformsToProtocol:@protocol(MTLTexture)] ? "texture" : "heap",
+             (__bridge void *)a, (unsigned long long)a.allocatedSize, b ? (long)b.storageMode : -1L,
+             b && b.storageMode == MTLStorageModeShared ? b.contents : NULL);
+    }
+}
+static void res_commit_at(const char *caller) { @autoreleasepool {
+    uint64_t seq = g_res_trace ? atomic_fetch_add(&g_res_trace_seq, 1) + 1 : 0;
+    uint64_t began = seq ? clock_gettime_nsec_np(CLOCK_UPTIME_RAW) : 0;
+    if (seq) MLOG("res trace #%llu %s begin lock", (unsigned long long)seq, caller);
     pthread_mutex_lock(&g_res_commit_mu);
+    if (seq) MLOG("res trace #%llu %s lock acquired, begin queue", (unsigned long long)seq, caller);
     pthread_mutex_lock(&g_res_mu);
     res_op *q = g_res_q; size_t n = g_res_qn; g_res_q = NULL; g_res_qn = g_res_qcap = 0;
     pthread_mutex_unlock(&g_res_mu);
     if (n) {
+        if (seq) res_trace_batch(seq, caller, q, n);
         uint64_t t0 = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+        if (seq) MLOG("res trace #%llu %s begin apply", (unsigned long long)seq, caller);
         for (size_t i = 0; i < n; i++) { if (q[i].add) [g_res addAllocation:(__bridge id<MTLAllocation>)q[i].o]; else [g_res removeAllocation:(__bridge id<MTLAllocation>)q[i].o]; }
+        if (seq) MLOG("res trace #%llu %s begin Metal commit", (unsigned long long)seq, caller);
         [g_res commit];
+        if (seq) MLOG("res trace #%llu %s Metal commit returned", (unsigned long long)seq, caller);
         uint64_t dt = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - t0;
         pthread_mutex_lock(&g_res_mu); g_rs_commits++; g_rs_commit_ns += dt; pthread_mutex_unlock(&g_res_mu);
     }
     pthread_mutex_unlock(&g_res_commit_mu);
     for (size_t i = 0; i < n; i++) CFRelease(q[i].o);
     free(q);
+    if (seq) MLOG("res trace #%llu %s end %.3f ms", (unsigned long long)seq, caller, (clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - began) / 1e6);
 } }
+#define res_commit() res_commit_at(__func__)
 static int res_pending(void) { pthread_mutex_lock(&g_res_mu); int n = g_res_qn != 0; pthread_mutex_unlock(&g_res_mu); return n; }
 // What the residency set holds: totals by kind and the largest objects. At the first GPU out-of-memory error (the error names none of them), and for DM_CTL "restop" (hle_hid.c). The set holds
 // the game's pools (shared buffers over guest memory), textures, heaps and staging alike
@@ -875,6 +918,7 @@ void mtl_init(void) {
