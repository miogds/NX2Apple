diff --git a/dm/gfx/tests/t_session_buffers.m b/dm/gfx/tests/t_session_buffers.m
new file mode 100644
index 0000000..4bab9e8
--- /dev/null
+++ b/dm/gfx/tests/t_session_buffers.m
@@ -0,0 +1,84 @@
+// Resource caches must release their ownership before the iOS shell restores __data/__bss.
+// Two real Metal sessions also check that newly returned resources belong to the new residency set.
+#include "../nvn/nvn_mtl.m"
+
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+
+static int checks, failed;
+#define CHECK(label, c) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s\n", label); } } while (0)
+
+static void session(int number) {
+    __weak id<MTLBuffer> wz, wd, ws, wb, wa, wv;
+    __weak id<MTLTexture> wt, wta;
+    __weak id<MTLTexture> wdt, wdi, wtb, wsrc, wview;
+    __weak id<MTLSamplerState> wds;
+    @autoreleasepool {
+        mtl_init();
+        CHECK("the session has a real residency set", g_res != nil);
+        @autoreleasepool {
+            res_commit();
+            NSSet *existing = [NSSet setWithArray:g_res.allAllocations];
+            bind_vbufs(nil, NULL);
+            res_commit();
+            id<MTLBuffer> vertexZero = nil;
+            for (id<MTLAllocation> allocation in g_res.allAllocations) {
+                if (![existing containsObject:allocation] && [allocation conformsToProtocol:@protocol(MTLBuffer)] && ((id<MTLBuffer>)allocation).length == 64) vertexZero = (id<MTLBuffer>)allocation;
+            }
+            wv = vertexZero;
+            CHECK("the vertex fallback registers a 64-byte buffer in each session", vertexZero != nil);
+            id<MTLBuffer> z = zero_buf(4096), d = dummy_buf(), s = support_buf(), b = zero_bank();
+            id<MTLTexture> t = dummy_img_atomic(MTLTextureType2D, NVN_DPF_FLOAT, 0);
+            id<MTLTexture> ta = dummy_img_atomic(MTLTextureTypeTextureBuffer, NVN_DPF_FLOAT, 0);
+            wz = z; wd = d; ws = s; wb = b; wt = t; wta = ta; wa = ta.buffer;
+            id<MTLTexture> dt = dummy_tex(MTLTextureType2D, NVN_DPF_FLOAT), di = dummy_img(MTLTextureType2D, NVN_DPF_FLOAT), tb = dummy_tbuf(NVN_DPF_FLOAT);
+            id<MTLSamplerState> ds = dummy_samp();
+            wdt = dt; wdi = di; wtb = tb; wds = ds;
+            MTLTextureDescriptor *desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm_sRGB width:128 height:128 mipmapped:NO];
+            desc.storageMode = MTLStorageModePrivate; desc.usage = MTLTextureUsageShaderRead | MTLTextureUsagePixelFormatView;
+            id<MTLTexture> src = [g_dev newTextureWithDescriptor:desc], view = present_raw_src(src);
+            wsrc = src; wview = view;
+            CHECK("the presentation cache owns a real view and its parent", view && view != src && view.parentTexture == src);
+            CHECK("dummy resource IDs belong to this session", g_dummy_tex_rid[MTLTextureType2D][NVN_DPF_FLOAT] == dt.gpuResourceID._impl && g_dummy_img_rid[MTLTextureType2D][NVN_DPF_FLOAT] == di.gpuResourceID._impl && g_dummy_tbuf_rid[NVN_DPF_FLOAT] == tb.gpuResourceID._impl && dummy_samp_rid() == ds.gpuResourceID._impl);
+            CHECK("zero fill, dummy, support and constant buffers exist", z && d && s && b);
+            CHECK("both atomic write sinks exist", t && ta && ta.buffer);
+            CHECK("cached GPU addresses belong to the current buffers", dummy_buf_gpu() == d.gpuAddress && support_gpu() == s.gpuAddress && zero_bank_gpu() == b.gpuAddress);
+            res_commit();
+            CHECK("zero fill buffer is resident", [g_res containsAllocation:z]);
+            CHECK("dummy buffer is resident", [g_res containsAllocation:d]);
+            CHECK("support buffer is resident", [g_res containsAllocation:s]);
+            CHECK("zero constant bank is resident", [g_res containsAllocation:b]);
+            CHECK("atomic texture is resident", [g_res containsAllocation:t]);
+            CHECK("atomic buffer texture's backing is resident", [g_res containsAllocation:ta.buffer]);
+            CHECK("dummy sampled texture is resident", [g_res containsAllocation:dt]);
+            CHECK("dummy image is resident", [g_res containsAllocation:di]);
+            CHECK("dummy buffer texture's backing is resident", [g_res containsAllocation:tb.buffer]);
+            CHECK("support render scales are initialized", ((float *)s.contents)[192 / 4] == 1.0f);
+        }
+        dm_gfx_teardown();
+    }
+    // After the autorelease pools have drained, only the production caches could own these objects.
+    CHECK("teardown releases the zero fill buffer", wz == nil);
+    CHECK("teardown releases the vertex fallback buffer", wv == nil);
+    CHECK("teardown releases the dummy buffer", wd == nil);
+    CHECK("teardown releases the support buffer", ws == nil);
+    CHECK("teardown releases the zero constant bank", wb == nil);
+    CHECK("teardown releases the atomic texture", wt == nil);
+    CHECK("teardown releases the atomic buffer texture and backing", wta == nil && wa == nil);
+    CHECK("teardown releases the sampled dummy texture", wdt == nil);
+    CHECK("teardown releases the dummy image", wdi == nil);
+    CHECK("teardown releases the buffer texture", wtb == nil);
+    CHECK("teardown releases the sampler", wds == nil);
+    CHECK("teardown releases the presentation view and its parent", wview == nil && wsrc == nil);
+    printf("session %d finished, %d checks, %d failed so far\n", number, checks, failed);
+}
+
+int main(void) {
+    session(1);
+    session(2);
+    printf("t_session_buffers: %d checks, %d failed\n", checks, failed);
+    return failed != 0;
+}
