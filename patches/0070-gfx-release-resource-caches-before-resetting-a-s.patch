+    pthread_mutex_lock(&g_present_raw_mu);
+    for (int i = 0; i < 4; i++) g_present_raw_views[i] = nil;
+    g_present_raw_next = 0;
+    pthread_mutex_unlock(&g_present_raw_mu);
