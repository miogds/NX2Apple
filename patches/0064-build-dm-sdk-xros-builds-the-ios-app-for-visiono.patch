From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: miogds <miogds@users.noreply.github.com>
Date: Tue, 17 Nov 2026 16:06:18 +0100
Subject: [PATCH] build: DM_SDK=xros builds the iOS app for visionOS

The smoke build (dm/ios/tools/build_smoke.py: the production project with
synthetic modules, no game files) takes the SDK from DM_SDK, iphoneos by
default. With DM_SDK=xros it writes the same project for visionOS (the
platform, the deployment target and device family 7) and links
Release-xros/DmIOS.app, a visionOS binary with the embedded segments.

- gen_build.py: the host's shaders, the compile commands and the SDK's
  frameworks are those of DM_SDK.
- host_msl.py, host/Makefile: --sdk xros compiles the host's own Metal
  shaders for visionOS 26.0. The Metal compiler has no -m<os>-version-min
  for it: the target triple carries the version.
- stage_resources.sh: a Vision Pro is a device too.

Without DM_SDK nothing changes. The game's shader libraries and
build_ipa.sh still target the iPhone SDK.

Upstream-Status: fork-only
Reason: visionOS is outside upstream's support matrix: DM_SDK=xros links the app for it in the smoke build
Issue: none yet (miogds/NX2Apple, visionOS evaluation branch; to be filed before this goes to LNPANDY/NX2Apple)

---
 dm/gfx/tools/host_msl.py        |  8 ++++++--
 dm/host/Makefile                |  1 +
 dm/ios/tools/build_smoke.py     | 19 ++++++++++++++-----
 dm/ios/tools/gen_build.py       | 11 +++++++----
 dm/ios/tools/stage_resources.sh |  2 +-
 5 files changed, 29 insertions(+), 12 deletions(-)

diff --git a/dm/gfx/tools/host_msl.py b/dm/gfx/tools/host_msl.py
index 766f855..df69ace 100644
--- a/dm/gfx/tools/host_msl.py
+++ b/dm/gfx/tools/host_msl.py
@@ -10,7 +10,7 @@
 import argparse, hashlib, os, subprocess, sys, tempfile
 
 ap = argparse.ArgumentParser()
-ap.add_argument('--sdk', required=True, choices=['macosx', 'iphoneos'])
+ap.add_argument('--sdk', required=True, choices=['macosx', 'iphoneos', 'xros'])
 ap.add_argument('--min', help='the lowest OS version the libraries must load on (iphoneos: the app\'s deployment target)')
 ap.add_argument('out')
 ap.add_argument('sources', nargs='+')
@@ -35,13 +35,17 @@ if os.path.exists(a.out):
 if not ver: print(f'host_msl.py: no Metal compiler for {a.sdk} (xcodebuild -downloadComponent MetalToolchain): the host compiles its shaders at run time', file=sys.stderr)
 out = ['// Generated by dm/gfx/tools/host_msl.py from dm/gfx/msl/*.metal: do not edit', stamp, f'#define HOST_MSL_SDK "{a.sdk}"', f'#define HOST_MSL_COMPILER "{ver or "none"}"']
 ents = []
+# The deployment target: visionOS has no -m<os>-version-min flag in the Metal compiler, its target triple carries the version
+def min_flag(sdk, v):
+    if not v: return []
+    return ['-target', f'air64-apple-xros{v}'] if sdk == 'xros' else [f'-m{"ios" if sdk == "iphoneos" else "macosx"}-version-min={v}']
 with tempfile.TemporaryDirectory() as td:
     for src, text in sources:
         name = os.path.splitext(os.path.basename(src))[0]
         lib = b''
         if ver:
             ml = os.path.join(td, name + '.metallib')
-            cmd = ['xcrun', '-sdk', a.sdk, 'metal'] + ([f'-m{"ios" if a.sdk == "iphoneos" else "macosx"}-version-min={a.min}'] if a.min else []) + ['-o', ml, src]
+            cmd = ['xcrun', '-sdk', a.sdk, 'metal'] + min_flag(a.sdk, a.min) + ['-o', ml, src]
             r = subprocess.run(cmd)
             if r.returncode: sys.exit(f'host_msl.py: {src} does not compile ({" ".join(cmd)})')
             lib = open(ml, 'rb').read()
diff --git a/dm/host/Makefile b/dm/host/Makefile
index c059b6b..0dcc404 100644
--- a/dm/host/Makefile
+++ b/dm/host/Makefile
@@ -58,6 +58,7 @@ $(DAV1D_LIB): $(DAV1D_OBJ)
 MSL_SDK ?= macosx
 MSL_MIN_macosx = $(MACOS_MIN)
 MSL_MIN_iphoneos = 26.0
+MSL_MIN_xros = 26.0
 MSL_SRC = $(sort $(wildcard ../gfx/msl/*.metal))
 MSL_H = gen/msl-$(MSL_SDK)/host_msl_gen.h
 # Recheck the toolchain and target on every build; the generator keeps the header unchanged when its inputs match.
diff --git a/dm/ios/tools/build_smoke.py b/dm/ios/tools/build_smoke.py
index 2e94b2e..6e52ff5 100644
--- a/dm/ios/tools/build_smoke.py
+++ b/dm/ios/tools/build_smoke.py
@@ -24,6 +24,9 @@ def main():
     parser = argparse.ArgumentParser(description=__doc__)
     parser.add_argument('--output', required=True, type=Path, help='new scratch directory for inputs and build products')
     args = parser.parse_args()
+    parser_sdk = os.environ.get('DM_SDK') or 'iphoneos'   # iphoneos, or xros: the same build for visionOS (gen_build.py reads it too)
+    if parser_sdk not in ('iphoneos', 'xros'): raise SystemExit(f'DM_SDK={parser_sdk}: iphoneos or xros')
+    sdk, osname = parser_sdk, 'visionOS' if parser_sdk == 'xros' else 'iOS'
     profile = game.load(os.environ.get('GAME') or os.environ.get('DM_GAME'))
     root = args.output.resolve()
     root.mkdir(parents=True)  # Never overwrite an existing project or build.
@@ -34,7 +37,13 @@ def main():
     tables.mkdir(parents=True)
     for name in ('Sources', 'tools'):
         (project / name).symlink_to(ios / name, target_is_directory=True)
-    shutil.copyfile(ios / 'project.yml', project / 'project.yml')
+    spec = (ios / 'project.yml').read_text()
+    if sdk == 'xros':   # the same project for visionOS: its platform, deployment target and device family (7, Apple Vision)
+        for old, new in (('    iOS: "26.0"', '    visionOS: "26.0"'), ('    platform: iOS\n', '    platform: visionOS\n'),
+                         ('TARGETED_DEVICE_FAMILY: "1,2"', 'TARGETED_DEVICE_FAMILY: "7"')):
+            if spec.count(old) != 1: raise RuntimeError(f'project.yml: expected one {old.strip()!r}')
+            spec = spec.replace(old, new)
+    (project / 'project.yml').write_text(spec)
     assets = gen / 'Assets.xcassets'
     assets.mkdir()
     (assets / 'Contents.json').write_text(json.dumps({'info': {'author': 'xcode', 'version': 1}}))
@@ -51,7 +60,7 @@ def main():
                           '# KEY_PAGE_OFF 0x8000\n# KEY_PAGE_SIZE 0x4000\n')
         shutil.copyfile(fixups, tables / fixups.name)
 
-    env = dict(os.environ, GAME=profile.id, DM_GAME=profile.id,
+    env = dict(os.environ, GAME=profile.id, DM_GAME=profile.id, DM_SDK=sdk,
                DM_BUNDLE_ID='org.nxnative.ci', DM_DISPLAY_NAME='CI build fixture',
                DM_APP_VERSION='1.0', DM_APP_CATEGORY=profile.get('app_category'),
                DM_TEAM_ID='', DM_SCHEME_NAME='DmIOS', DM_APPICON='',
@@ -81,13 +90,13 @@ def main():
     run(sys.executable, ios / 'tools/gen_resources.py', project, romfs, marker,
         shaders, f'b-{chain}', '', derived, chain_h)
     run('xcodebuild', '-project', project / 'DmIOS.xcodeproj', '-scheme', 'DmIOS',
-        '-configuration', 'Release', '-destination', 'generic/platform=iOS',
+        '-configuration', 'Release', '-destination', f'generic/platform={osname}',
         '-derivedDataPath', derived, '-jobs', '3',
         'CODE_SIGNING_ALLOWED=NO', 'CODE_SIGNING_REQUIRED=NO', 'CODE_SIGN_IDENTITY=',
         f'DM_XCODE_OUTPUT_ROOT={derived}', f'SYMROOT={derived}/Build/Products',
         f'OBJROOT={derived}/Build/Intermediates.noindex', 'build')
 
-    app = derived / 'Build/Products/Release-iphoneos/DmIOS.app'
+    app = derived / f'Build/Products/Release-{sdk}/DmIOS.app'
     info = plistlib.loads((app / 'Info.plist').read_bytes())
     executable = app / info['CFBundleExecutable']
     if not executable.is_file():
@@ -98,7 +107,7 @@ def main():
             raise RuntimeError(f'Resource staging failed: {packed}')
     if (app / '_CodeSignature').exists() or (app / 'embedded.mobileprovision').exists():
         raise RuntimeError('The smoke-test app must be unsigned')
-    print(f'iOS smoke build passed: {executable}', flush=True)
+    print(f'{osname} smoke build passed: {executable}', flush=True)
 
 
 if __name__ == '__main__':
diff --git a/dm/ios/tools/gen_build.py b/dm/ios/tools/gen_build.py
index f1e7db4..457901d 100644
--- a/dm/ios/tools/gen_build.py
+++ b/dm/ios/tools/gen_build.py
@@ -6,11 +6,14 @@
 #                     which only Mac code under TARGET_OS_OSX uses, would fail the link; each one left out is named on stderr)
 # Usage: gen_build.py <dm/host dir> <Gen dir>
 import os, shlex, subprocess, sys
+# DM_SDK: the SDK the app is built for, iphoneos (the default) or xros (visionOS: the same sources, dm/ios/tools/build_smoke.py)
+SDK = os.environ.get('DM_SDK') or 'iphoneos'
+if SDK not in ('iphoneos', 'xros'): sys.exit(f'gen_build: DM_SDK={SDK}: iphoneos or xros')
 host, gen = os.path.abspath(sys.argv[1]), os.path.abspath(sys.argv[2])
 # Generate the game profile header and the host's shaders compiled for iOS (MSL_SDK=iphoneos: gen/msl-iphoneos, dm/gfx/tools/host_msl.py) for real first (make -n below only prints;
 # GAME comes from the environment). The compile command is then the iOS one: its -I names the iOS shader header
-subprocess.run(['make', '-s', '-C', host, 'game_profile', 'host_msl', 'MSL_SDK=iphoneos'], check=True)
-cmd = subprocess.run(['make', '-s', '-n', '-B', '-C', host, 'dmhost', 'MSL_SDK=iphoneos'], capture_output=True, text=True, check=True).stdout
+subprocess.run(['make', '-s', '-C', host, 'game_profile', 'host_msl', f'MSL_SDK={SDK}'], check=True)
+cmd = subprocess.run(['make', '-s', '-n', '-B', '-C', host, 'dmhost', f'MSL_SDK={SDK}'], capture_output=True, text=True, check=True).stdout
 # The host's own commands first (its per-source compiles and its link), then the per-file compile commands of the libraries it depends on (libvpx, dav1d: their objects go to
 # gen/vpx and gen/dav1d): header paths keep this order, so the host's headers are found first
 lines = [shlex.split(l) for l in cmd.splitlines() if l.lstrip().startswith('clang')]
@@ -43,8 +46,8 @@ for s in srcs:
     os.symlink(s, f'{gen}/src/{flat}')
 print('HEADER_SEARCH_PATHS = $(inherited) ' + ' '.join(f'"{d}"' for d in incs + dirs))
 print('OTHER_CFLAGS = $(inherited) ' + ' '.join(defs))
-sdk = subprocess.run(['xcrun', '--sdk', 'iphoneos', '--show-sdk-path'], capture_output=True, text=True, check=True).stdout.strip()
+sdk = subprocess.run(['xcrun', '--sdk', SDK, '--show-sdk-path'], capture_output=True, text=True, check=True).stdout.strip()
 fws = list(dict.fromkeys(fws))
 mac_only = [f for f in fws if not os.path.isdir(f'{sdk}/System/Library/Frameworks/{f}.framework')]
-if mac_only: print('gen_build: not in the iOS SDK, left out of the link: ' + ' '.join(mac_only), file=sys.stderr)
+if mac_only: print(f'gen_build: not in the {SDK} SDK, left out of the link: ' + ' '.join(mac_only), file=sys.stderr)
 print('DM_FRAMEWORKS = ' + ' '.join(f'-framework {f}' for f in fws if f not in mac_only))
diff --git a/dm/ios/tools/stage_resources.sh b/dm/ios/tools/stage_resources.sh
index 13a9224..751ec19 100644
--- a/dm/ios/tools/stage_resources.sh
+++ b/dm/ios/tools/stage_resources.sh
@@ -4,7 +4,7 @@
 set -eu
 [ "${DM_COPY_GAME_RESOURCES:-YES}" != NO ] || exit 0
 die() { echo "[RED] $*" >&2; exit 1; }
-[ "${PLATFORM_NAME:-}" = iphoneos ] || die 'This game needs a physical iPhone or iPad; choose a device, not a simulator.'
+case "${PLATFORM_NAME:-}" in iphoneos|xros) ;; *) die 'This game needs a physical iPhone, iPad or Vision Pro; choose a device, not a simulator.';; esac
 [ -f "${SRCROOT:?}/Gen/resources.env" ] || die 'Missing game resource paths; run build_ipa_from_nsp.py --prepare-xcode first.'
 source "$SRCROOT/Gen/resources.env"
 APP="${TARGET_BUILD_DIR:?}/${UNLOCALIZED_RESOURCES_FOLDER_PATH:?}"
