diff --git a/dm/gfx/tests/t_session_programs.m b/dm/gfx/tests/t_session_programs.m
new file mode 100644
index 0000000..376c0a8
--- /dev/null
+++ b/dm/gfx/tests/t_session_programs.m
@@ -0,0 +1,175 @@
+// Last-program and border-specialization owners must end before the shell's raw framework reset.
+// Two real backend starts deliberately reuse descriptor addresses, serials and serial-table generations.
+#include "../nvn/nvn_mtl.m"
+
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+
+static int checks, failed;
+#define CHECK(c, label) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s\n", label); } } while (0)
+
+static size_t buffer_bytes(NvProg *p) {
+    uintptr_t seen[12] = {0}; size_t count = 0, bytes = 0;
+    for (int s = 0; p && s < 6; s++) {
+        NvShader *sh = p->sh[s]; if (!sh) continue;
+        id<MTLBuffer> buffers[] = {sh->c1buf, sh->ab_buf};
+        for (int b = 0; b < 2; b++) {
+            id<MTLBuffer> buffer = buffers[b]; if (!buffer) continue;
+            uintptr_t ptr = (uintptr_t)(__bridge void *)buffer; int duplicate = 0;
+            for (size_t i = 0; i < count; i++) duplicate |= seen[i] == ptr;
+            if (!duplicate) { seen[count++] = ptr; bytes += buffer.length; }
+        }
+    }
+    return bytes;
+}
+
+static NvProg *make_program(id<MTLLibrary> lib) {
+    NvProg *p = [NvProg new];
+    for (int s = 0; s < 2; s++) {
+        NvShader *sh = [NvShader new]; sh->stage = s; p->sh[s] = sh;
+        snprintf(sh->key, sizeof sh->key, "session%d_b", s);
+        if (lib) sh->fn = [lib newFunctionWithName:s ? @"f" : @"v"];
+        if (s == 1) { sh->rf.color_known = 1; sh->rf.color_mask = 1; }
+        sh->rf.c1_len = 16; sh->rf.c1 = calloc(1, 16); c1_store(sh);
+        // No argument encoder in these simple shaders. Exercise ownership of production arena storage explicitly.
+        id<MTLBuffer> ab; sh->ab_off = arena_alloc(256, &ab); sh->ab_buf = ab; sh->ab_gpu = ab.gpuAddress + sh->ab_off;
+    }
+    return p;
+}
+
+static void replace_lookup(void) {
+    static prog_t sentinel = {.serial = 991003};
+    NvProg *p = [NvProg new]; serial_put(sentinel.serial, p);
+    CHECK(prog_get(&sentinel) == p, "replace the lookup owner to isolate the draw owner");
+}
+
+static void render_program(prog_t *pg, int number) {
+    tex_t t = {.magic = MAGIC('T', 'E', 'X', 0), .serial = 991002};
+    t.d = (nvn_texdesc){.target = NVN_TEXTURE_TARGET_2D, .format = NVN_FORMAT_RGBA8, .width = 8, .height = 8, .depth = 1, .levels = 1, .samples = 1};
+    MTLTextureDescriptor *desc = tex_desc(&t, 0); desc.storageMode = MTLStorageModeShared;
+    id<MTLTexture> out = [g_dev newTextureWithDescriptor:desc]; res_add(out); mtl_tex_init(&t); serial_put(t.serial, out);
+    state_reset(); memset(&R, 0, sizeof R); mtl_sub_begin();
+    R.has_rt = 1; R.rt.n = 1; R.rt.color[0] = &t; R.clear_c[0] = 1; R.cc[0] = MTLClearColorMake(0, 0, 0, 0);
+    S.prog = pg; S.ds.dt = S.ds.dw = S.ds.st = 0; S.poly.cull = 0; S.color.blend_en = 0; S.chmask.mask = 0xffff;
+    p_draw command = {.prim = 4, .count = 3, .instances = 1};
+    draw(&command, NULL);
+    // The second draw takes the same-pass last-program/pipeline fast path.
+    uint64_t pass = g_pass.serial; draw(&command, NULL);
+    CHECK(g_pass.serial == pass, "the second draw reuses this session's render pass");
+    CHECK(mtl_wait(mtl_sub_commit(), 5000000000ull), "real rendering completes");
+    CHECK(!mtl_last_commit_error(), "real rendering has no GPU error");
+    uint8_t pixels[8 * 8 * 4]; [out getBytes:pixels bytesPerRow:8 * 4 fromRegion:MTLRegionMake2D(0, 0, 8, 8) mipmapLevel:0];
+    int k = (4 * 8 + 4) * 4;
+    CHECK(number == 1 ? pixels[k] > 200 && pixels[k + 1] < 10 : pixels[k] < 10 && pixels[k + 1] > 200,
+          "pixels use the current session's shader, red then green");
+    replace_lookup();
+    mtl_tex_release(&t);
+}
+
+static void program_session(const char *mode, int number) {
+    int render = !strcmp(mode, "draw"), mutate = !strcmp(mode, "serial");
+    static prog_t pg = {.serial = 991001};
+    static uint64_t first_generation;
+    __weak NvProg *wp;
+    __weak NvShader *wv;
+    __weak NvShader *wf;
+    __weak id<MTLBuffer> wc;
+    __weak id<MTLBuffer> wa;
+    @autoreleasepool {
+        mtl_init();
+        CHECK(g_dev && g_res, "each session starts a real Metal backend and residency set");
+        CHECK(serial_get(pg.serial) == nil, "the serial owner table is empty after restart");
+        @autoreleasepool {
+            id<MTLLibrary> lib = nil;
+            if (render) {
+                NSError *error = nil;
+                NSString *source = [NSString stringWithFormat:@"#include <metal_stdlib>\nusing namespace metal;\n"
+                    "vertex float4 v(uint i [[vertex_id]]){float2 p[3]={float2(-1,-1),float2(3,-1),float2(-1,3)};return float4(p[i],.5,1);}\n"
+                    "fragment float4 f(){return float4(%d,%d,0,1);}\n", number == 1, number == 2];
+                lib = [g_dev newLibraryWithSource:source options:nil error:&error];
+                CHECK(lib != nil, "synthetic render library compiles");
+                if (!lib) { fprintf(stderr, "%s\n", error.localizedDescription.UTF8String); return; }
+            }
+            NvProg *p = make_program(lib);
+            wp = p; wv = p->sh[0]; wf = p->sh[1]; wc = p->sh[0]->c1buf; wa = p->sh[0]->ab_buf;
+            CHECK(p->sh[0]->c1buf == p->sh[1]->c1buf && p->sh[0]->ab_buf == p->sh[1]->ab_buf, "the fixture shares both buffers");
+            CHECK(buffer_bytes(p) == 8u << 20, "deduplicate the fixture's two 4 MiB buffers");
+            serial_put(pg.serial, p);
+            if (number == 1) first_generation = g_ser_gen;
+            CHECK(g_ser_gen == first_generation, "the restarted serial table repeats the first session's generation");
+            CHECK(prog_get(&pg) == p, "reused address, serial and generation resolve to the new program");
+            CHECK(prog_get(&pg) == p, "same-session cached lookup returns the current program");
+            if (mutate) {
+                NvProg *other = [NvProg new];
+                serial_put(pg.serial, other);
+                CHECK(prog_get(&pg) == other, "a generation change replaces the cached serial's object");
+                serial_put(pg.serial + 1, p); pg.serial++;
+                CHECK(prog_get(&pg) == p, "the same descriptor address can bind another serial");
+                pg.serial--; CHECK(prog_get(&pg) == other, "restoring its serial restores that serial's object");
+                serial_put(pg.serial, p); CHECK(prog_get(&pg) == p, "final lookup owns the fixture under its original serial");
+            }
+            if (render) render_program(&pg, number);
+            res_commit();
+            CHECK([g_res containsAllocation:p->sh[0]->c1buf] && [g_res containsAllocation:p->sh[0]->ab_buf], "current shader buffers belong to the current residency set");
+        }
+        dm_gfx_teardown();
+    }
+    CHECK(wp == nil, "teardown releases the last program");
+    CHECK(wv == nil && wf == nil, "teardown releases both shaders");
+    CHECK(wc == nil && wa == nil, "teardown releases the constant bank and argument arena");
+    CHECK(buffer_bytes(wp) == 0, "no fixture buffer bytes remain reachable through the program");
+    CHECK(g_dev == nil && g_res == nil, "the backend and residency owner have stopped");
+    printf("program session %s/%d: %d checks, %d failed so far\n", mode, number, checks, failed);
+}
+
+static void border_session(int number) {
+    __weak id<MTLLibrary> wl;
+    __weak MTL4FunctionDescriptor *wd;
+    __weak MTL4FunctionDescriptor *wn;
+    __weak FnOff *wo;
+    __weak FnOff *wno;
+    @autoreleasepool {
+        mtl_init();
+        CHECK(g_dev && g_res, "border session starts a real backend");
+        CHECK(g_fn_off.count == 0, "the border cache starts empty in each session");
+        @autoreleasepool {
+            NSError *error = nil;
+            NSString *source = [NSString stringWithFormat:@"#include <metal_stdlib>\nusing namespace metal;\n"
+                "constant bool dm_border_off [[function_constant(%u)]];\n"
+                "kernel void probe(device uint *out [[buffer(0)]]){out[0]=dm_border_off ? %uu : 3u;}\n"
+                "kernel void plain(device uint *out [[buffer(0)]]){out[0]=1u;}\n", DMSH_BORDER_FC, 6 + number];
+            id<MTLLibrary> lib = [g_dev newLibraryWithSource:source options:nil error:&error];
+            CHECK(lib != nil, "synthetic border library compiles");
+            if (!lib) { fprintf(stderr, "%s\n", error.localizedDescription.UTF8String); return; }
+            wl = lib;
+            id<MTLFunction> f = fn4_note([lib newFunctionWithName:@"probe"], lib, @"probe", nil);
+            wd = fn4_of(f); FnOff *off = fn_off(f); wo = off;
+            CHECK(off && off->d4 && !off->none, "production helper records the supported specialization");
+            CHECK(fn_off(f) == off, "repeated lookup returns the same specialization record");
+            id<MTLFunction> no = fn4_note([lib newFunctionWithName:@"plain"], lib, @"plain", nil);
+            wn = fn4_of(no); CHECK(fn_off(no) == nil, "a function without the border constant has no variant");
+            FnOff *none = [g_fn_off objectForKey:fn4_of(no)]; wno = none;
+            CHECK(none && none->none, "the negative lookup is cached");
+            CHECK(fn_off(no) == nil && g_fn_off.count == 2, "repeated lookups keep exactly two descriptor-keyed entries");
+            CHECK(fn4_of_b(f, 1) == off->d4 && fn4_of_b(f, 0) == wd, "the selector preserves original and specialized descriptors");
+        }
+        dm_gfx_teardown();
+    }
+    CHECK(g_fn_off == nil, "teardown drops the border cache owner");
+    CHECK(wd == nil && wn == nil && wo == nil && wno == nil, "teardown releases positive and negative entries and descriptor keys");
+    CHECK(wl == nil, "teardown releases the synthetic library's descriptor ownership");
+    printf("border session %d: %d checks, %d failed so far\n", number, checks, failed);
+}
+
+int main(int argc, char **argv) {
+    if (argc != 2 || (strcmp(argv[1], "lookup") && strcmp(argv[1], "serial") && strcmp(argv[1], "draw") && strcmp(argv[1], "border"))) return 2;
+    setenv("DM_PSO_ARCHIVE", "off", 1); setenv("DM_PSO_MANIFEST", "off", 1);
+    for (int n = 1; n <= 2; n++) {
+        if (!strcmp(argv[1], "border")) border_session(n); else program_session(argv[1], n);
+    }
+    printf("t_session_programs %s: %d checks, %d failed\n", argv[1], checks, failed);
+    return failed != 0;
+}
