@@ -0,0 +1,28 @@
+#!/usr/bin/env python3
+"""Write an iOS project template (project.yml, project-framework.yml) for another SDK of DM_SDK.
+
+Usage: project_sdk.py <sdk> <template> <out>
+  iphoneos  the template as it is
+  xros      visionOS: every target's platform, the deployment target and device family 7 (Apple Vision)
+The templates stay the iOS ones: build_ipa.sh and build_smoke.py write the visionOS project from them, so a change
+to a template reaches both platforms. A template this does not recognise is an error, not a silent iOS project."""
+import re, sys
+
+SDKS = ('iphoneos', 'xros')
+
+
+def convert(text, sdk):
+    if sdk == 'iphoneos': return text
+    if sdk != 'xros': raise ValueError(f'DM_SDK={sdk}: one of {", ".join(SDKS)}')
+    for pattern, new in ((r'^(\s+)iOS: "(\d+\.\d+)"', r'\1visionOS: "\2"'), (r'^(\s+)platform: iOS$', r'\1platform: visionOS'),
+                         (r'TARGETED_DEVICE_FAMILY: "1,2"', 'TARGETED_DEVICE_FAMILY: "7"')):
+        text, n = re.subn(pattern, new, text, flags=re.M)
+        if not n: raise ValueError(f'no line matches {pattern!r}')
+    return text
+
+
+if __name__ == '__main__':
+    if len(sys.argv) != 4: sys.exit(__doc__)
+    try: out = convert(open(sys.argv[2], encoding='utf-8').read(), sys.argv[1])
+    except ValueError as e: sys.exit(f'project_sdk.py: {sys.argv[2]}: {e}')
+    open(sys.argv[3], 'w', encoding='utf-8').write(out)
